# Copy to .env and fill in for local overrides. None of this is required to
# run the project locally (manage.py runserver works with zero setup) - it
# exists so a real deployment can configure itself entirely through
# environment variables, with no code changes and nothing secret committed.
#
# A REAL DEPLOYMENT MUST SET AT LEAST: DJANGO_SECRET_KEY, DJANGO_DEBUG=False,
# DJANGO_ALLOWED_HOSTS. Everything else has a safe default.

# Required in production - generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Must be False in production - a debug 500 page leaks source and settings.
DJANGO_DEBUG=False

# Comma-separated list of hostnames this deployment serves, e.g.:
DJANGO_ALLOWED_HOSTS=api.example.com

# Set to False only if this deployment is intentionally served over plain
# HTTP (e.g. behind a proxy that already terminates TLS and you've confirmed
# it forwards X-Forwarded-Proto correctly). Defaults to True.
DJANGO_SECURE_SSL_REDIRECT=True

# Requests-per-window ceiling per client IP on POST /api/route/. Protects
# both this server and the free upstream OSRM/Census APIs from abuse.
DJANGO_ANON_THROTTLE_RATE=30/min

# Only needed if you're pointing at a different OSRM instance (e.g. a
# self-hosted one) or want to override the Census geocoder endpoint.
# OSRM_BASE_URL=https://router.project-osrm.org
# CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress

# Optional, and only used by `manage.py load_fuel_stations` - a one-time
# live-geocode fallback for CSV rows the offline place table can't match
# (e.g. a future CSV update with a station in a town too obscure for that
# static table). Free, no credit card: https://www.geoapify.com/. Loading
# works fine with this unset - unmatched rows are just skipped and reported,
# same as before this existed.
# GEOAPIFY_API_KEY=
